{
  "name": "openclaw-newapi-balance",
  "version": "0.2.0",
  "description": "Read-only new-api account balance and usage tools for OpenClaw",
  "type": "module",
  "license": "MIT",
  "author": { "name": "freeleepm", "url": "https://github.com/freeleepm" },
  "repository": { "type": "git", "url": "git+https://github.com/freeleepm/openclaw-newapi-balance.git" },
  "homepage": "https://github.com/freeleepm/openclaw-newapi-balance#readme",
  "bugs": { "url": "https://github.com/freeleepm/openclaw-newapi-balance/issues" },
  "engines": { "node": ">=24.16.0 <25 || >=26.1.0" },
  "files": ["dist", "openclaw.plugin.json", "README.md", "LICENSE"],
  "openclaw": {
    "extensions": ["./dist/index.js"],
