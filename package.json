  "peerDependencies": { "openclaw": ">=2026.9.8" },
  "peerDependenciesMeta": { "openclaw": { "optional": true } },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "openclaw": "2026.9.9",
    "typescript": "~5.9.3"
  }
